# Copy to `.env` and fill in. Everything here is OPTIONAL — the arena runs
# fully offline with none of it set.

# --- LLM agents (Phase 2) -------------------------------------------------
# Groq API key. Without it, agents use the deterministic SimplePolicy.
GROQ_API_KEY=
# Set to 1 to let Groq drive the agents + mutation (needs GROQ_API_KEY).
PIT_USE_LLM=0
# Model for agent decisions + mutation (Groq lineup, 2026).
PIT_LLM_MODEL=openai/gpt-oss-120b
# 1 = agents are told the evolutionary stakes (lose => replaced by a mutation
# of the winner). 0 = agents run "blind". A knob to experiment with.
PIT_AGENT_AWARE=1

# --- Different brain per agent, on different providers --------------------
# DeepSeek: cheap, paid, OWN metered account — not a shared free pool like
# OpenRouter's ":free" models (which get rate-limited fast under real usage).
# Get a key + add a few dollars of credit at platform.deepseek.com. Prefix a
# model with "deepseek:" to route there.
DEEPSEEK_API_KEY=
PIT_RONIN_MODEL=deepseek:deepseek-v4-flash
# Both default to the cheap model (flash). deepseek-v4-pro costs ~3x more —
# set PIT_VIPER_MODEL=deepseek:deepseek-v4-pro yourself once you want that.
PIT_VIPER_MODEL=deepseek:deepseek-v4-flash

# Optional: OpenRouter (free tier is rate-limited: 20/min, 50/day shared
# across all of OpenRouter's free users — expect it to run dry under any real
# usage). Prefix a model with "openrouter:" to route there.
OPENROUTER_API_KEY=

# --- Arena tuning (all have sane defaults in config.py) -------------------
# PIT_BASE_CAPITAL=100000
# PIT_DAILY_STOP_LOSS_PCT=3.78          # portfolio stop-loss, scaled by sqrt(days)
# PIT_RISK_REWARD_RATIO=1.5             # take-profit = stop-loss * this ratio
# PIT_POSITION_STOP_LOSS_PCT=8.0        # per-position hard stop
# PIT_WIN_STAKE_BONUS_PCT=25
# PIT_LOSS_STAKE_PENALTY_PCT=20
# PIT_MIDDLE_PLACE_PENALTY_PCT=8        # 3+-way rounds: middle finisher's penalty
# PIT_PASSIVE_WIN_STAKE_BONUS_PCT=8     # win on zero trades gets this instead
# PIT_START_ROUND_DAYS=7
# PIT_MIN_ROUND_DAYS=5
# PIT_ELO_K=32

# --- Market + universe ----------------------------------------------------
# Which market the autonomous agents trade: "us" (default) or "nse".
PIT_MARKET=us

# --- Data source ----------------------------------------------------------
# "yfinance" (default, free, DELAYED ~15min) or "alpaca" (free real-time US via
# IEX + a real movers screener). Alpaca needs a free key from alpaca.markets.
PIT_DATA_SOURCE=yfinance
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# The agents pick any ticker themselves; these only override the movers
# discovery reference / offline pool (a bad ticker is just skipped):
# PIT_UNIVERSE=AAPL,TSLA,NVDA,COIN,...
# PIT_UNIVERSE_FILE=./data/tickers.txt   # one ticker per line

# --- Storage --------------------------------------------------------------
# PIT_DB_PATH=./data/pit.db

# --- Live broker (Phase 4 — DhanHQ; NOT needed for paper phases) ----------
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=
