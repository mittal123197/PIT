# Copy to `.env` and fill in. Everything here is OPTIONAL — the arena runs
# fully offline with none of it set.

# --- LLM agents (Phase 2) -------------------------------------------------
# Groq API key. Without it, agents use the deterministic SimplePolicy.
GROQ_API_KEY=
# Set to 1 to let Groq drive the agents + mutation (needs GROQ_API_KEY).
PIT_USE_LLM=0
# Model for agent decisions + mutation.
PIT_LLM_MODEL=llama-3.3-70b-versatile
# 1 = agents are told the evolutionary stakes (lose => replaced by a mutation
# of the winner). 0 = agents run "blind". A knob to experiment with.
PIT_AGENT_AWARE=1

# --- Arena tuning (all have sane defaults in config.py) -------------------
# PIT_BASE_CAPITAL=100000
# PIT_STOP_LOSS_PCT=15
# PIT_STAKE_DELTA_PCT=20
# PIT_START_ROUND_DAYS=7
# PIT_MIN_ROUND_DAYS=4
# PIT_ELO_K=32

# --- Storage --------------------------------------------------------------
# PIT_DB_PATH=./data/pit.db

# --- Live broker (Phase 4 — DhanHQ; NOT needed for paper phases) ----------
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=
