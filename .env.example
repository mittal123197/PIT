# Copy to `.env` and fill in. Agents whose provider key is missing simply hold.

# --- Each lineage's model (provider-prefixed) ------------------------------
PIT_RONIN_MODEL=anthropic:claude-sonnet-5-5
PIT_VIPER_MODEL=deepseek:deepseek-reasoner
PIT_LYNX_MODEL=gemini:gemini-3.5-flash
PIT_CLAUDE_EFFORT=medium          # medium | high (Claude reasoning depth)

# --- Provider keys (only the ones your models use) -------------------------
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=                   # Google AI Studio; a free-tier key works
OPENROUTER_API_KEY=               # for openrouter:<model>
GROQ_API_KEY=                     # for a bare Groq model id

# --- Market ------------------------------------------------------------------
PIT_MARKET=us                     # us | crypto
PIT_TRADE_UNIVERSE=top100         # top100 | crypto
PIT_QUOTE_REFRESH_SEC=15          # live price cache (seconds)
# PIT_DATA_SOURCE=alpaca          # real-time IEX quotes (needs ALPACA_API_KEY/SECRET)

# --- Arena -------------------------------------------------------------------
PIT_BASE_CAPITAL=1000
PIT_CHARTER_ENFORCE=1             # reject buys outside the agent's own charter
# PIT_SPREAD_BPS=3                # half-spread per fill (default 3 US, 8 crypto)
# PIT_CHARTER_ITERS=3             # pre-round backtest→refine passes
# PIT_ELO_K=32
# PIT_DB_PATH=./data/pit.db
